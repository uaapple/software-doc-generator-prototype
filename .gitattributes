# Normalize text files in the repository to LF by default.
* text=auto eol=lf

# Keep common source and document formats consistent across macOS and Windows.
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.svg text eol=lf
*.csv text eol=lf
*.env text eol=lf

# Windows-native scripts keep CRLF to avoid local execution surprises.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Treat binary assets as binary so Git never rewrites them.
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.zip binary
