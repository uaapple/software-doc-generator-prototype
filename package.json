{
  "name": "software-doc-generator-prototype",
  "version": "0.1.0",
  "description": "Phase-one prototype for generating software requirements from system PDFs and model artifacts.",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "hermes:start": "node --disable-warning=ExperimentalWarning src/hermes-server.js",
    "hermes:dev": "node --disable-warning=ExperimentalWarning --watch src/hermes-server.js",
    "wiki:start": "node --disable-warning=ExperimentalWarning src/wiki-server.js",
    "wiki:dev": "node --disable-warning=ExperimentalWarning --watch src/wiki-server.js",
    "matlab:gateway:start": "node scripts/start-matlab-gateway.mjs",
    "matlab:gateway:check": "node scripts/start-matlab-gateway.mjs --check",
    "release:zip": "node scripts/build-release-zip.mjs",
    "release:zip:linux": "node scripts/build-release-zip.mjs --target linux-prod",
    "release:zip:windows-full": "node scripts/build-release-zip.mjs --target windows-prod-full",
    "release:zip:windows-source": "node scripts/build-release-zip.mjs --target windows-prod-source",
    "install:tcsd-python": "node scripts/tcsd-python-dependencies.mjs install",
    "check:tcsd-python": "node scripts/tcsd-python-dependencies.mjs check",
    "classify:changes": "node scripts/classify-changes.mjs",
    "test": "node --disable-warning=ExperimentalWarning tests/run-tests.js && node tests/slx-parser-tests.js && node tests/tcsd-pipeline-contract-tests.js && node tests/release-rollback-package-tests.mjs && sh tests/rollback-linux-release-tests.sh",
    "test:linux-release-rollback": "sh tests/rollback-linux-release-tests.sh",
    "test:release-rollback-packages": "node tests/release-rollback-package-tests.mjs",
    "check:wiki": "node scripts/check-wiki.mjs",
    "check:skills-db-diff": "node scripts/check-skills-db-diff.mjs",
    "check:encoding": "node scripts/check-text-encoding.mjs",
    "check:container-boundaries": "node scripts/check-container-boundaries.mjs",
    "check:container-secrets": "node scripts/check-container-secrets.mjs",
    "test:container-config": "node tests/container-config-tests.mjs && node tests/container-production-config-tests.mjs && node tests/container-secret-scan-tests.mjs && node tests/tcsd-remote-transfer-tests.mjs",
    "test:container-worker": "node tests/container-worker-static-tests.mjs && python3 tests/container-worker-hermes-config-tests.py",
    "test:matlab-gateway": "node tests/matlab-gateway-contract-tests.mjs && python3 tests/tcsd-runtime/test_satk_gateway.py",
    "container:dev:up": "node scripts/container-dev.mjs up",
    "container:dev:down": "node scripts/container-dev.mjs down",
    "container:dev:build": "node scripts/container-dev.mjs build",
    "container:dev:config": "node scripts/container-dev.mjs config",
    "container:dev:status": "node scripts/container-dev.mjs status",
    "container:dev:restart": "node scripts/container-dev.mjs restart",
    "container:dev:test": "node scripts/container-dev.mjs test",
    "container:manifest": "node scripts/container-release-manifest.mjs",
    "container:scan": "node scripts/container-scan.mjs",
    "container:release:build": "node scripts/build-container-release.mjs --offline",
    "container:release:publish": "node scripts/build-container-release.mjs --push",
    "container:prod:windows:config": "node scripts/container-production.mjs windows-worker config",
    "container:prod:windows:preflight": "node scripts/container-production.mjs windows-worker preflight",
    "container:prod:windows:up": "node scripts/container-production.mjs windows-worker up",
    "container:prod:windows:test": "node scripts/container-production.mjs windows-worker test",
    "container:prod:windows:status": "node scripts/container-production.mjs windows-worker status",
    "container:prod:windows:down": "node scripts/container-production.mjs windows-worker down",
    "container:prod:linux:config": "node scripts/container-production.mjs linux-platform config",
    "container:prod:linux:preflight": "node scripts/container-production.mjs linux-platform preflight",
    "container:prod:linux:up": "node scripts/container-production.mjs linux-platform up",
    "container:prod:linux:test": "node scripts/container-production.mjs linux-platform test",
    "container:prod:linux:status": "node scripts/container-production.mjs linux-platform status",
    "container:prod:linux:down": "node scripts/container-production.mjs linux-platform down",
    "fix:encoding": "node scripts/fix-text-encoding.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "openai": "^5.22.0",
    "pdf-parse": "^1.1.1"
  }
}
