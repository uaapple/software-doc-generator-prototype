{
  "name": "software-doc-generator-prototype",
  "version": "0.1.0",
  "description": "Phase-one prototype for generating software requirements from system PDFs and model artifacts.",
  "type": "module",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "hermes:start": "node --disable-warning=ExperimentalWarning src/hermes-server.js",
    "hermes:dev": "node --disable-warning=ExperimentalWarning --watch src/hermes-server.js",
    "wiki:start": "node --disable-warning=ExperimentalWarning src/wiki-server.js",
    "wiki:dev": "node --disable-warning=ExperimentalWarning --watch src/wiki-server.js",
    "test": "node --disable-warning=ExperimentalWarning tests/run-tests.js",
    "check:wiki": "node scripts/check-wiki.mjs",
    "check:skills-db-diff": "node scripts/check-skills-db-diff.mjs",
    "check:encoding": "node scripts/check-text-encoding.mjs",
    "fix:encoding": "node scripts/fix-text-encoding.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "openai": "^5.22.0",
    "pdf-parse": "^1.1.1"
  }
}
