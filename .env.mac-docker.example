# Copy to .env (untracked) and fill in. The DEEPSEEK_API_KEY never leaves this
# file; do not commit it. Token generation: see docs/mac-docker-local-stack.md.

# ── images ──────────────────────────────────────────────────────────────────
SDG_BACKEND_IMAGE=software-doc-generator/tcsd-backend:dev
SDG_DSH_WORKER_IMAGE=software-doc-generator/tcsd-dsh-worker:dev

# ── shared data (backend + worker + MATLAB Gateway see the same host dir) ───
SDG_MAC_DATA_DIR=/Users/a0000/Documents/DSH_Proj/tcsd-worker-port/data-docker
SDG_MAC_LOG_DIR=/Users/a0000/Documents/DSH_Proj/tcsd-worker-port/data-docker/logs/worker
SDG_DSH_HOME_VOLUME_NAME=sdg-dsh-home-mac

# ── model provider (worker runs the DSH headless session) ───────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── MATLAB Gateway reachability (host process, port 5100) ───────────────────
SATK_GATEWAY_URL=http://host.docker.internal:5100
