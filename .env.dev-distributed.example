# Mac development profile that keeps local convenience while exercising production-style boundaries.
APP_ENV=development
APP_RUNTIME_ROLE=platform

HOST=::
PORT=3000

# Platform calls Hermes through its local HTTP service instead of shelling out to the CLI.
HERMES_TRANSPORT=api
HERMES_BASE_URL=http://127.0.0.1:3101
HERMES_TASK_CONCURRENCY=1
HERMES_SERVER_REQUEST_TIMEOUT_MS=0
HERMES_TIMEOUT_SIMULINK_MODULE_DESCRIPTION_GENERATE_MS=3600000
HERMES_MAX_TURNS_SIMULINK_MODULE_DESCRIPTION_GENERATE=10000
# Optional for the Hermes Agent service process when it shells out locally.
# HERMES_PROFILE=deepseek

# Optional when the platform and Hermes Agent see the same task workspace through different roots.
# Keep empty for single-Mac development. Set to a Windows path in split VM deployments when needed.
# UNIT_TEST_CASE_AGENT_WORKSPACE_ROOT=C:\\software-doc-generator\\data\\unit-test-case-generation\\tasks
# Optional override for the independent software detail design/module-description task workspace.
# Defaults to UNIT_TEST_CASE_AGENT_WORKSPACE_ROOT when unset.
# SOFTWARE_MODULE_DESCRIPTION_AGENT_WORKSPACE_ROOT=C:\\software-doc-generator\\data\\software-module-description-generation\\tasks
UNIT_TEST_CASE_PROJECT_ADMIN_CODE=114301
UNIT_TEST_CASE_DEFAULT_PROJECTS=01_楚能,02_TMS
# Local Mac/all-in-one addon packages use the same numbered folder convention as Windows production.
# UNIT_TEST_CASE_PROJECT_ADDON_ROOT=.local/project-addons
UNIT_TEST_CASE_EXPECTED_OUTPUT_PATTERN=outputs/*_tcsd.xlsx
UNIT_TEST_CASE_REMOTE_POLL_WINDOW_MS=300000
UNIT_TEST_CASE_RECONCILE_INTERVAL_MS=30000
SOFTWARE_MODULE_DESCRIPTION_SKILL_NAME=simulink-module-description-generator
SOFTWARE_MODULE_DESCRIPTION_EXPECTED_OUTPUT_PATTERN=outputs/*.docx

# Platform calls the MATLAB worker through HTTP; run the worker/Hermes service separately on this Mac.
MATLAB_MCP_TRANSPORT=http
MATLAB_MCP_BASE_URL=http://127.0.0.1:5100
MATLAB_MCP_TIMEOUT_MS=300000

# Optional local isolation. Leave unset to use repo-local data/ and skills/ during quick development.
# APP_DATA_DIR=.local/dev-data
# APP_SKILLS_DIR=.local/dev-skills
