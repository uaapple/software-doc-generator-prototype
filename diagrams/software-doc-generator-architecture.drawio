          <mxGeometry x="25.0" y="70.0" width="90.0" height="120.0" as="geometry" />
        </mxCell>
        <mxCell id="frontend_ui" value="1. 用户上传资料并点击生成&#10;网页界面&#10;选择项目、上传文件、发起生成" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#333333;fontSize=14;fillColor=#D9EAF7;" vertex="1" parent="1">
          <mxGeometry x="130.0" y="55.0" width="250.0" height="120.0" as="geometry" />
        </mxCell>
        <mxCell id="express_api" value="2. 系统接收生成请求&#10;后端接口&#10;把前端请求交给生成流程" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#333333;fontSize=14;fillColor=#DCECC9;" vertex="1" parent="1">
          <mxGeometry x="420.0" y="60.0" width="220.0" height="110.0" as="geometry" />
        </mxCell>
        <mxCell id="project_service" value="4. 先把材料归档&#10;记录项目、文件名、文件类型、上传时间&#10;方便后续追溯" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;strokeColor=#333333;fontSize=14;fillColor=#FCE5CD;" vertex="1" parent="1">
          <mxGeometry x="300.0" y="300.0" width="260.0" height="120.0" as="geometry" />
        </mxCell>
        <mxCell id="pipeline_service" value="3. 生成流程总控&#10;把'读取输入-抽取信息-调用大模型-校验结果'串起来" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#333333;fontSize=14;fillColor=#FFF2CC;" vertex="1" parent="1">
          <mxGeometry x="700.0" y="55.0" width="300.0" height="120.0" as="geometry" />
        </mxCell>
        <mxCell id="local_storage" value="项目资料库&#10;保存原始输入、生成结果、审核记录" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;strokeColor=#333333;fontSize=14;fillColor=#CFE2F3;" vertex="1" parent="1">
          <mxGeometry x="250.0" y="545.0" width="250.0" height="120.0" as="geometry" />
        </mxCell>
        <mxCell id="extraction_service" value="5. 从输入材料里提取关键信息&#10;PDF: 提取正文、段落、关键描述&#10;C 代码: 提取函数、条件、阈值、接口线索&#10;产出: 摘要 + 证据片段" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#333333;fontSize=14;fillColor=#F4CCCC;" vertex="1" parent="1">
          <mxGeometry x="600.0" y="280.0" width="310.0" height="155.0" as="geometry" />
        </mxCell>
        <mxCell id="llm_service" value="7. 调用大模型生成软件设计需求&#10;把'项目背景 + 输入证据 + 编写规范'一起发给大模型&#10;未配置 API 时走本地规则兜底" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#333333;fontSize=14;fillColor=#D9D2E9;" vertex="1" parent="1">
          <mxGeometry x="1220.0" y="280.0" width="320.0" height="150.0" as="geometry" />
        </mxCell>
        <mxCell id="validation_service" value="8. 自动检查生成结果&#10;是否缺来源&#10;是否有重复&#10;是否表述模糊" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#333333;fontSize=14;fillColor=#F9CB9C;" vertex="1" parent="1">
          <mxGeometry x="1220.0" y="505.0" width="260.0" height="120.0" as="geometry" />
        </mxCell>
        <mxCell id="skill_template" value="6. 准备生成规范&#10;需求编写规则 skills&#10;文档模板 template&#10;输出格式 schema" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;strokeColor=#333333;fontSize=14;fillColor=#FFF2CC;" vertex="1" parent="1">
          <mxGeometry x="950.0" y="300.0" width="240.0" height="120.0" as="geometry" />
        </mxCell>
        <mxCell id="input_files" value="输入材料&#10;系统需求 PDF&#10;模型说明 PDF&#10;生成的 C 代码&#10;SLX 模型文件(当前预留)" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=0.27;strokeColor=#333333;fontSize=14;fillColor=#EAD1DC;" vertex="1" parent="1">
