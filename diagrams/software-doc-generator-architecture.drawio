        </mxCell>
        <mxCell id="output_artifacts" value="9. 形成软件设计需求草稿&#10;需求条目 requirements&#10;来源追溯 traces&#10;风险/冲突提示 conflicts" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;strokeColor=#333333;fontSize=14;fillColor=#FCE5CD;" vertex="1" parent="1">
          <mxGeometry x="900.0" y="540.0" width="260.0" height="130.0" as="geometry" />
