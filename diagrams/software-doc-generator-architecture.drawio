        </mxCell>
        <mxCell id="openai_api" value="大模型能力&#10;理解输入材料&#10;按规范组织内容&#10;生成结构化需求条目" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;strokeColor=#333333;fontSize=14;fillColor=#D0E0E3;" vertex="1" parent="1">
