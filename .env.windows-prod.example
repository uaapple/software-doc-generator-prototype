# Windows VM service profile. This host runs Hermes Agent and MATLAB/MCP-adjacent services.
APP_ENV=production
APP_RUNTIME_ROLE=hermes-agent

HERMES_HOST=0.0.0.0
HERMES_PORT=3101
HERMES_TRANSPORT=cli
HERMES_COMMAND=hermes
# Optional: set when the Windows Hermes CLI should run through a named profile.
# If enabled, remove HERMES_STATE_DB_PATH below or point it at that profile's state.db.
# HERMES_PROFILE=deepseek
HERMES_WORKDIR=C:\\software-doc-generator\\current
HERMES_STATE_DB_PATH=C:\\Users\\Administrator\\.hermes\\state.db
HERMES_SERVER_REQUEST_TIMEOUT_MS=0
HERMES_TIMEOUT_SOFTWARE_REQUIREMENT_MARKDOWN_GENERATE_MS=600000
HERMES_TIMEOUT_SIMULINK_UT_TCSD_GENERATE_MS=3600000
HERMES_TIMEOUT_SIMULINK_MODULE_DESCRIPTION_GENERATE_MS=3600000
HERMES_MAX_TURNS_SIMULINK_UT_TCSD_GENERATE=10000
HERMES_MAX_TURNS_SIMULINK_MODULE_DESCRIPTION_GENERATE=10000
UNIT_TEST_CASE_PROJECT_ADMIN_CODE=114301
UNIT_TEST_CASE_DEFAULT_PROJECTS=01_楚能,02_TMS
UNIT_TEST_CASE_PROJECT_ADDON_ROOT=C:\\ProgramData\\SoftwareDocGenerator\\project-addons
UNIT_TEST_CASE_SKILL_NAME=simulink-ut-tcsd-generator
UNIT_TEST_CASE_EXPECTED_OUTPUT_PATTERN=outputs/*_tcsd.xlsx
SOFTWARE_MODULE_DESCRIPTION_SKILL_NAME=simulink-module-description-generator
SOFTWARE_MODULE_DESCRIPTION_EXPECTED_OUTPUT_PATTERN=outputs/*.docx

MATLAB_MCP_TRANSPORT=stdio
SLX_ANALYSIS_BACKEND=satk
SIMULINK_AGENTIC_TOOLKIT_ROOT=C:\\Users\\Administrator\\.matlab\\agentic-toolkits\\simulink
MATLAB_MCP_TIMEOUT_MS=300000
MATLAB_MCP_TMPDIR=C:\\software-doc-generator\\tmp
SATK_MCP_LOG_FOLDER=C:\\Temp\\matlab-mcp-core-server-codex
SATK_MATLAB_SESSION_MODE=new
# SATK_MATLAB_ROOT=C:\\Program Files\\MATLAB\\R2026a

APP_DATA_DIR=C:\\software-doc-generator\\data
APP_SKILLS_DIR=C:\\software-doc-generator\\skills
