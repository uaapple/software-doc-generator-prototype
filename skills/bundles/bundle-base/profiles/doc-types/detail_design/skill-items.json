  "items": [
    {
      "skillCode": "DOC-detail_design-writing_rule-001",
      "layer": "docType",
      "profileKey": "detail_design",
      "kind": "writing_rule",
      "title": "详细设计输出定位",
      "content": "详细设计输出应描述“软件内部实现分解”，不是仅复述系统需求，也不是把源码变量逐句翻译成说明文字。",
      "order": 1,
      "status": "active",
      "sectionKey": "写作定位"
    },
    {
      "skillCode": "DOC-detail_design-writing_rule-002",
      "layer": "docType",
      "profileKey": "detail_design",
      "kind": "writing_rule",
      "title": "实现展开要素",
      "content": "每条详细设计除主行为外，还应尽量写出内部变量、中间量、模式分支、承接路径或限幅关系，形成可审核的实现展开。",
      "order": 2,
      "status": "active",
      "sectionKey": "写作定位"
    },
    {
      "skillCode": "DOC-detail_design-writing_rule-003",
      "layer": "docType",
      "profileKey": "detail_design",
      "kind": "writing_rule",
      "title": "允许实现性句式",
      "content": "正文允许使用“其中”“注”“计算方法为”等实现展开句式，以承载计算方法、上一时刻量、模式判断和边界限制。",
      "order": 3,
      "status": "active",
      "sectionKey": "写作定位"
    },
    {
      "skillCode": "DOC-detail_design-writing_rule-004",
      "layer": "docType",
      "profileKey": "detail_design",
      "kind": "writing_rule",
      "title": "层级保留但不强制编号",
      "content": "标题层级仍应保留“父功能 -> 子功能 -> 设计点”的结构，但除非用户明确要求，不强制复现原始章节号。",
      "order": 4,
      "status": "active",
      "sectionKey": "结构组织"
    },
    {
      "skillCode": "DOC-detail_design-writing_rule-005",
      "layer": "docType",
      "profileKey": "detail_design",
      "kind": "writing_rule",
      "title": "结构化内容一致性",
      "content": "每条详细设计的 `structuredContent` 应与正文语义一致，至少能映射出可审阅的 `designBreakdown`。",
      "order": 5,
      "status": "active",
      "sectionKey": "结构组织"
    },
    {
      "skillCode": "DOC-detail_design-writing_rule-006",
      "layer": "docType",
      "profileKey": "detail_design",
      "kind": "writing_rule",
      "title": "详细设计优先内部量",
      "content": "与软件需求相比，详细设计可以更显式写出内部量计算方法、上一时刻量、模式枚举和限幅路径，但不得脱离系统需求边界创造新功能主题。",
      "order": 6,
      "status": "active",
      "sectionKey": "写作定位"
    },
    {
      "skillCode": "DOC-detail_design-extraction_rule-001",
      "layer": "docType",
      "profileKey": "detail_design",
      "kind": "extraction_rule",
      "title": "输入源优先级",
      "content": "系统需求优先定义功能边界、对象和主控制主题；模型代码与模型文档主要提供实现展开、内部变量、模式分支和限幅细节。",
      "order": 7,
      "status": "active",
      "sectionKey": "抽取重点"
    },
    {
      "skillCode": "DOC-detail_design-extraction_rule-002",
      "layer": "docType",
      "profileKey": "detail_design",
      "kind": "extraction_rule",
      "title": "中间量单独抽取",
      "content": "抽取时除条件和动作外，还应单独归档中间变量、上一时刻量、模式分支、默认承接路径、限幅链路和注释型实现说明。",
      "order": 8,
      "status": "active",
      "sectionKey": "抽取重点"
    },
    {
      "skillCode": "DOC-detail_design-extraction_rule-003",
      "layer": "docType",
      "profileKey": "detail_design",
      "kind": "extraction_rule",
      "title": "二级结构拆证据",
      "content": "若同一设计点同时存在“正文主逻辑 + 其中/注”的二级结构，应分别建立事实集合，避免实现展开在写作阶段丢失。",
      "order": 9,
      "status": "active",
      "sectionKey": "抽取重点"
    },
    {
      "skillCode": "DOC-detail_design-extraction_rule-004",
      "layer": "docType",
      "profileKey": "detail_design",
      "kind": "extraction_rule",
      "title": "代码细节只做细化",
      "content": "对 `detail_design` 可以从代码中抽取实现细节，但这些事实只能补充和细化已存在的功能主题，不能覆盖系统需求边界或新增未要求的功能。",
      "order": 10,
      "status": "active",
      "sectionKey": "抽取重点"
    },
    {
      "skillCode": "DOC-detail_design-extraction_rule-005",
      "layer": "docType",
      "profileKey": "detail_design",
      "kind": "extraction_rule",
      "title": "对象级证据优先",
      "content": "对前轴/后轴、请求/退出、主路径/默认路径等对象或流程分支，应优先保留对象级证据集合，不要在抽取阶段先行合并。",
      "order": 11,
      "status": "active",
      "sectionKey": "抽取重点"
    },
    {
      "skillCode": "DOC-detail_design-validation_rule-001",
      "layer": "docType",
      "profileKey": "detail_design",
      "kind": "validation_rule",
      "title": "详细设计基础字段校验",
      "content": "每条详细设计必须同时具备 `requirementText`、`sourceRefs`、`verificationHint` 和 `structuredContent`，任一缺失都应判为高风险。",
      "order": 12,
      "status": "active",
      "sectionKey": "校验重点"
    },
    {
      "skillCode": "DOC-detail_design-validation_rule-002",
      "layer": "docType",
      "profileKey": "detail_design",
      "kind": "validation_rule",
      "title": "实现展开充分性校验",
      "content": "若正文只有需求复述，没有实现分解、内部变量、分支承接、模式判断或限幅说明，应判为“过于像软件需求”。",
      "order": 13,
      "status": "active",
      "sectionKey": "校验重点"
    },
    {
      "skillCode": "DOC-detail_design-validation_rule-003",
      "layer": "docType",
      "profileKey": "detail_design",
      "kind": "validation_rule",
      "title": "结构化内容空壳校验",
      "content": "若 `structuredContent` 为空壳，或与正文中的主行为、分支和对象归属不一致，应判为高风险结构问题。",
      "order": 14,
      "status": "active",
      "sectionKey": "校验重点"
    },
    {
      "skillCode": "DOC-detail_design-validation_rule-004",
      "layer": "docType",
      "profileKey": "detail_design",
      "kind": "validation_rule",
      "title": "对象级设计点校验",
      "content": "若输出只写总述，没有落到对象级设计点、对称子项或默认路径，应判为结构不完整。",
      "order": 15,
      "status": "active",
      "sectionKey": "校验重点"
    },
    {
      "skillCode": "DOC-detail_design-validation_rule-005",
      "layer": "docType",
      "profileKey": "detail_design",
      "kind": "validation_rule",
      "title": "实现细节越位校验",
      "content": "若把代码局部实现直接抬升为新的功能主题，或脱离系统需求新增章节，应标记为越界扩写。",
      "order": 16,
      "status": "active",
      "sectionKey": "校验重点"
    },
    {
