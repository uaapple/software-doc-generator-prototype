{
  "id": "windows-prod-source",
  "description": "Windows VM source update package without bundled platform-specific MCP binaries or runtime data.",
  "releaseBranch": "release/windows-prod",
  "packagePrefix": "software-doc-generator-windows-source",
  "latestAlias": "latest-windows-source.zip",
  "includePaths": [
    ".env.defaults",
    ".env.windows-prod.example",
    ".env.windows-docker-desktop.example",
    "compose.windows-docker-desktop.yaml",
    "containers",
    "deploy/container-license-policy.json",
    "README.md",
    "package.json",
    "package-lock.json",
    "src",
    "public",
    "wiki",
    "skills",
    "scripts",
    "requirements",
    "tools/matlab-functions",
    "tools/matlab-mcp-extension.json",
    "templates",
    "docs"
  ],
  "excludePaths": [
    "data",
    "input",
    "output",
    "release-dist",
    "test-fixtures",
    "videos",
    "tools/matlab-mcp-core-server",
    "tools/matlab-mcp-core-server.exe",
    "scripts/build-native-matlab-gateway-companion.mjs",
    "scripts/deploy-native-matlab-gateway.ps1",
    "scripts/rollback-linux-release.sh"
  ],
  "copyFiles": [
    "scripts/deploy-release.ps1",
    "scripts/install-windows-services.ps1",
    "scripts/install-tcsd-hermes-skills.mjs",
    "scripts/install-tcsd-hermes-skills.ps1"
  ],
  "runtimeDataPolicy": "Runtime data, mutable external skills, Hermes sessions and heavyweight local tool binaries are external to this source update package; the twelve immutable TCSD stage skills and shared tcsd-runtime source are bundled under skills/hermes."
}
