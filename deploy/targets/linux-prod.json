{
  "id": "linux-prod",
  "description": "Linux platform package for the web/backend entrypoint that calls remote Hermes and MATLAB worker services.",
  "releaseBranch": "release/linux-prod",
  "packagePrefix": "software-doc-generator-linux",
  "latestAlias": "latest-linux.zip",
  "includePaths": [
    ".env.defaults",
    ".env.linux-prod.example",
    ".env.linux-container-prod.example",
    "compose.linux-prod.yaml",
    "docker",
    "deploy/container-license-policy.json",
    "deploy/releases",
    "README.md",
    "package.json",
    "package-lock.json",
    "src",
    "public",
    "wiki",
    "skills",
    "scripts",
    "templates",
    "docs"
  ],
  "excludePaths": [
    "data",
    "input",
    "output",
    "release-dist",
    "test-fixtures",
    "videos",
    "skills/hermes/tcsd-runtime",
    "skills/hermes/tcsd-stage-*",
    "skills/hermes/software-detail-runtime",
    "skills/hermes/software-detail-stage-*",
    "presets/unit-test-case-generation-production",
    "tools",
    "scripts/deploy-release.ps1",
    "scripts/install-windows-services.ps1",
    "scripts/install-tcsd-hermes-skills.mjs",
    "scripts/install-tcsd-hermes-skills.ps1",
    "scripts/tcsd-python-dependencies.mjs",
    "scripts/check-tcsd-python.py",
    "requirements/tcsd-runtime.txt",
    "scripts/build-native-matlab-gateway-companion.mjs",
    "scripts/deploy-native-matlab-gateway.ps1",
    "scripts/restore-windows-worker-source.ps1",
    "scripts/update-windows-worker-source.ps1",
    "scripts/build-windows-worker-source-update.mjs"
  ],
  "copyFiles": [],
  "runtimeDataPolicy": "Linux production keeps APP_DATA_DIR and APP_SKILLS_DIR outside the code directory, persists remote TCSD and software-detail jobId state, and reconciles remote staged jobs through HTTP without packaging runtime data."
}
