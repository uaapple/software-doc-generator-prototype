# Copy to .env.container for local container development.
# Never commit .env.container or place real secrets in this example.

OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=
ZHIPU_API_KEY=
ZHIPU_MODEL=
ZHIPU_BASE_URL=

# Worker-only Hermes Agent 0.18.2 inference mapping. The Mac development
# default is DeepSeek; the API key remains empty in this tracked example.
HERMES_INFERENCE_PROVIDER=deepseek
HERMES_INFERENCE_MODEL=deepseek-v4-pro
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# For the compatible zai path, set HERMES_INFERENCE_PROVIDER=zai and use the
# existing ZHIPU_MODEL/ZHIPU_API_KEY/ZHIPU_BASE_URL values above. Compose maps
# them to the GLM_* variable names recognized by Hermes Agent.

# Required local secrets. Generate independent random values in .env.container.
# Never reuse API keys or commit the populated file.
HERMES_AGENT_TOKEN=
MATLAB_GATEWAY_TOKEN=
MATLAB_GATEWAY_EVALUATE_TOKEN=

# Mac host paths. They remain outside every image layer.
SDG_CONTAINER_DATA_DIR=.local/container/data
SDG_PROJECT_ADDONS_DIR=.local/project-addons
SDG_PLATFORM_LOG_DIR=.local/container/logs/platform
SDG_WORKER_LOG_DIR=.local/container/logs/worker
MATLAB_GATEWAY_STATE_DIR=.local/container/matlab-gateway-state

# Fixed-version development references. Release builds must override these
# with immutable @sha256 references and record them in the OCI manifest.
SDG_NODE_IMAGE=node:22.22.3-bookworm-slim@sha256:e21fc383b50d5347dc7a9f1cae45b8f4e2f0d39f7ade28e4eef7d2934522b752
SDG_PYTHON_IMAGE=python:3.11.9-slim-bookworm@sha256:8fb099199b9f2d70342674bd9dbccd3ed03a258f26bbd1d556822c6dfc60c317
SDG_PLATFORM_IMAGE=sdg-platform:mac-dev
SDG_WORKER_IMAGE=sdg-hermes-worker:mac-dev

# Host-native MATLAB Gateway.
MATLAB_MCP_BASE_URL=http://host.docker.internal:5100
MATLAB_MCP_TIMEOUT_MS=300000
SATK_GATEWAY_URL=http://host.docker.internal:5100
SATK_GATEWAY_MAPPING_ID=worker-data
MATLAB_GATEWAY_CONTAINER_ROOT=/var/lib/sdg/data

# Local development ports.
SDG_PLATFORM_PORT=3000
SDG_WORKER_PORT=3101

# Hermes Agent is installed in the worker image; its state is mounted outside.
HERMES_PROFILE=
TCSD_STAGE_HERMES_PROFILE=
TCSD_STAGE_HERMES_MAX_TURNS=200
TCSD_STAGE_HERMES_TIMEOUT_MS=3600000

# Project catalog is configuration only; project files stay in the addon mount.
UNIT_TEST_CASE_PROJECT_ADMIN_CODE=114301
UNIT_TEST_CASE_DEFAULT_PROJECTS=01_楚能,02_TMS
