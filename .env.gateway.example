# Copy to .env.gateway (untracked) and fill in. Runs the MATLAB Gateway on the
# Mac host (native node + MATLAB R2026a). Tokens: openssl rand -hex 32, twice.

# Gateway listener (host process)
MATLAB_WORKER_HOST=127.0.0.1
MATLAB_WORKER_PORT=5100

# Authentication: Bearer token for normal requests + separate evaluate token
# for executing arbitrary MATLAB code. The worker container receives these ONLY
# via the root-owned secrets file (secrets/tcsd-gateway.env), never in env.
MATLAB_GATEWAY_TOKEN=
MATLAB_GATEWAY_EVALUATE_TOKEN=

# Workspace mapping: worker-data maps the worker container root to the host dir
# shared with the backend and worker containers (SDG_MAC_DATA_DIR in .env).
MATLAB_GATEWAY_MAPPING_ID=worker-data
MATLAB_GATEWAY_CONTAINER_ROOT=/var/lib/sdg/data
MATLAB_GATEWAY_HOST_ROOT=/Users/a0000/Documents/DSH_Proj/tcsd-worker-port/data-docker
MATLAB_GATEWAY_STATE_DIR=/Users/a0000/Documents/DSH_Proj/tcsd-worker-port/data-docker/.tcsd-gateway-state

# MATLAB (host native)
MATLAB_ROOT=/Applications/MATLAB_R2026a.app
SATK_MATLAB_ROOT=/Applications/MATLAB_R2026a.app
